# Environment
ENVIRONMENT=development
DEBUG=true

# Application
PROJECT_NAME="Payment Orchestration Layer"
PROJECT_VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=payment_layer
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Explicit URLs (Optional - overrides individual DB_* variables if supplied)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/payment_layer
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/payment_layer
